DISCORD_TOKEN=your_bot_token_here
FIXEMBED_BASE_URL=https://fixembed.app/embed?url=
SUPPRESS_ORIGINAL_EMBEDS=true
REPLY_MODE=reply

# Per-site fixer 可在此覆蓋（日後 fixer 改網域時只需改 .env）
FIXER_TWITTER=fxtwitter.com
FIXER_THREADS=fixthreads.seria.moe
FIXER_THREADS_SECONDARY=threadsez.net
FIXER_REDDIT=rxddit.com
FIXER_PIXIV=phixiv.net
FIXER_BLUESKY=bskx.app
FIXER_BILIBILI=vxbilibili.com
FIXER_FACEBOOK=facebed.com

# === @西寶 AI 回應（可選）===
# 自動 fallback 鏈，依「付費優先→品質→fallback」排列：
#   DeepSeek (paid) → Cerebras (Qwen 235B free) → Groq (70B → 8B) → Gemini
# 任何一層被 429 / 失敗 → 自動掉下一層 → 全部失敗 → 走寫死的隨機回覆

# --- 第一層：DeepSeek（付費但超便宜、中文最強、反應快、不會 queue）---
# 申請：https://platform.deepseek.com/ （手機或 Google 登入，充值最少 $2 USD）
# 定價：V3.2 input $0.28/M, output $0.42/M → 單日 100 次 bot 呼叫約 $0.001 美元
# 模型：deepseek-chat (V3.2 一般)、deepseek-reasoner (R1 推理，較貴)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# --- 第二層：Cerebras（中文最強、免費 1M tokens/day、最大模型）---
# 申請：https://cloud.cerebras.ai/platform/ （Google 登入，Free tier）
# 可用模型（curl https://api.cerebras.ai/v1/models 查看）：
#   qwen-3-235b-a22b-instruct-2507（中文最強，推薦）
#   zai-glm-4.7（清華 GLM，中文也很好）
#   gpt-oss-120b、llama3.1-8b
CEREBRAS_API_KEY=
CEREBRAS_MODEL=qwen-3-235b-a22b-instruct-2507

# --- 第三層：Groq（免費額度大、速度快、適合備援）---
# 申請：https://console.groq.com/keys （Google 登入、按 Create，不用綁卡）
# 免費額度：Llama 3.3 70B 每日 100k tokens / Llama 3.1 8B 每日 500k tokens
# GROQ_MODELS 逗號分隔，依序 fallback（前面爆了就掉下一個）
GROQ_API_KEY=
GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant

# --- 第四層：Gemini（注意：綁 billing 的專案會被關閉 free tier）---
# 申請：https://aistudio.google.com/apikey → 選 "Create API key in new project"
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- 共用設定 ---
# AI_PROVIDER=groq                # 只用指定層（deepseek | cerebras | groq | gemini），留空=全鏈
AI_TIMEOUT_MS=8000
# 回覆字數與記憶深度改由 /tier 指令 per-guild 設定（簡短/標準/精細），不再用 env。
# 持久化在 data/tier-settings.json。
AI_MEMORY_TTL_MS=1800000            # 30 分鐘沒動靜就清空該頻道記憶
# 自訂西寶人格（留空會使用預設模板）。模板可用 {SENTENCE_MIN}/{SENTENCE_MAX} 佔位符，
# 實際值會由 guild 當下的 tier 置換。
# AI_PERSONA=
