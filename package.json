{
  "name": "discord-social-preview-bot",
  "version": "0.1.0",
  "private": true,
  "description": "A lightweight Discord bot that previews Meta Threads, X/Twitter, and other supported links using FixEmbed.",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "test": "npm run test:pure && npm run test:routing && npm run test:circuit && npm run test:voice && npm run test:skills && npm run test:translation",
    "test:translation": "node scripts/smoke-translation.js",
    "eval:translation": "node scripts/eval-translation.js",
    "test:pure": "node scripts/smoke.js",
    "test:routing": "node scripts/routing-smoke.js",
    "test:circuit": "node scripts/smoke-ai-circuit.js",
    "test:voice": "node scripts/smoke-voice.js",
    "test:skills": "node scripts/smoke-skills.js"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "dotenv": "^16.4.5",
    "node-cron": "^4.2.1",
    "playwright": "^1.59.1",
    "sharp": "^0.35.4"
  },
  "overrides": {
    "@discordjs/rest": {
      "undici": "6.29.0"
    },
    "discord.js": {
      "undici": "6.29.0"
    }
  }
}
